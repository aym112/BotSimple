# --- Database ---
DATABASE_URL=postgresql+psycopg://policylens:policylens@localhost:5433/policylens
DATABASE_URL_TEST=postgresql+psycopg://policylens:policylens@localhost:5433/policylens_test

# --- Auth (demo, single account) ---
DEMO_USERNAME=demo
# Generate with: uv run python -m app.auth.hash_password "your-password"
# (scrypt-based, not Argon2 - see docs/decisions.md for why)
DEMO_PASSWORD_HASH=
AUTH_SECRET=change-me-to-a-random-64-char-secret
AUTH_TOKEN_TTL_MINUTES=720

# --- Documents / derived corpus artifacts (relative to repo root) ---
DOCUMENTS_DIR=data/documents
MARKDOWN_DIR=data/markdown
CHROMA_DIR=data/chroma

# --- LLM / embeddings provider (OpenAI - agent with tool use) ---
OPENAI_API_KEY=
CHAT_MODEL=gpt-5.4-mini
EMBEDDING_MODEL=text-embedding-3-small

# --- LangSmith tracing (optional) ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=policylens

# --- App ---
ENV=development
CORS_ORIGINS=http://localhost:5173
